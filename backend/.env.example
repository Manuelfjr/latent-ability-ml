WORKSHOP_BACKEND_HOST=127.0.0.1
WORKSHOP_BACKEND_PORT=8765
WORKSHOP_BACKEND_ALLOW_ORIGIN=*

# Admin analytics stays opt-in.
WORKSHOP_ENABLE_ADMIN_ANALYTICS=false
WORKSHOP_ADMIN_USERNAME=admin
WORKSHOP_ADMIN_PASSWORD=change-me

# Optional custom path for the analytics log.
# WORKSHOP_ANALYTICS_FILE=/absolute/path/to/analytics.jsonl
